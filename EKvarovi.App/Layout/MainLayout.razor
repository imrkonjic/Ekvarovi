@inherits LayoutComponentBase
@inject JwtAuthStateProvider AuthState
@inject LookupCache Lookups
@inject NavigationManager Navigation

<MudLayout>
    <AuthorizeView>
        <Authorized>
            <MudAppBar Elevation="1">
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               OnClick="ToggleDrawer" />
                <MudText Typo="Typo.h6">e-Kvarovi Županije</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="LogoutAsync">
                    Odjava
                </MudButton>
            </MudAppBar>
            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1">
                <NavMenu />
            </MudDrawer>
        </Authorized>
    </AuthorizeView>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            await Lookups.EnsureLoadedAsync();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task LogoutAsync()
    {
        Lookups.Clear();
        await AuthState.NotifyUserLogoutAsync();
        Navigation.NavigateTo("/login");
    }
}
