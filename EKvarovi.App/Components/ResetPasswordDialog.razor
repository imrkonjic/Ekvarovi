@using EKvarovi.Shared.Dtos.Users
@inject ApiClient Api

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Reset lozinke</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Korisnik: <b>@UserDisplayName</b>
        </MudText>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">@_error</MudAlert>
        }

        <MudTextField @bind-Value="_newPassword"
                      Label="Nova lozinka"
                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="TogglePasswordVisibility"
                      Required="true"
                      HelperText="Najmanje 8 znakova" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="_busy || string.IsNullOrWhiteSpace(_newPassword)"
                   OnClick="SubmitAsync">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Spremi
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public int UserId { get; set; }

    [Parameter, EditorRequired]
    public string UserDisplayName { get; set; } = string.Empty;

    private string _newPassword = string.Empty;
    private bool _showPassword;
    private bool _busy;
    private string? _error;

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPassword))
            return;

        _busy = true;
        _error = null;

        try
        {
            await Api.ResetUserPasswordAsync(UserId, new ResetPasswordDto
            {
                NewPassword = _newPassword
            });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiClientException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => MudDialog.Close(DialogResult.Cancel());
}
