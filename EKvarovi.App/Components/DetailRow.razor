<MudStack Row="true" Spacing="2" AlignItems="@(Multiline ? AlignItems.Start : AlignItems.Center)">
    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width: 140px;">
        <b>@Label:</b>
    </MudText>
    <MudText Typo="Typo.body2" Style="@(Multiline ? "white-space: pre-wrap;" : null)">
        @Value
    </MudText>
</MudStack>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public bool Multiline { get; set; }
}
