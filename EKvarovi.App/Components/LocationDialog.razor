@using EKvarovi.Shared.Dtos.Locations
@inject ApiClient Api
@inject LookupCache Lookups

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEdit ? "Uredi lokaciju" : "Nova lokacija")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-3" />
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">@_error</MudAlert>
        }

        @if (!_loading)
        {
            <MudForm @ref="_form" Model="_model" @bind-IsValid="_valid">
                <MudTextField @bind-Value="_model.Code"
                              Label="Šifra"
                              Required="true"
                              Counter="20"
                              MaxLength="20"
                              Immediate="true"
                              Class="mb-3" />
                <MudTextField @bind-Value="_model.Name"
                              Label="Naziv"
                              Required="true"
                              Counter="150"
                              MaxLength="150"
                              Immediate="true"
                              Class="mb-3" />
                <MudTextField @bind-Value="_model.Address"
                              Label="Adresa"
                              Required="true"
                              Counter="200"
                              MaxLength="200"
                              Immediate="true"
                              Class="mb-3" />
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="_model.City"
                                      Label="Grad"
                                      Required="true"
                                      Counter="100"
                                      MaxLength="100"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_model.PostalCode"
                                      Label="Poštanski broj"
                                      Counter="10"
                                      MaxLength="10"
                                      Immediate="true" />
                    </MudItem>
                </MudGrid>
                <MudSelect T="int"
                           @bind-Value="_model.LocationTypeId"
                           Label="Vrsta lokacije"
                           Required="true"
                           RequiredError="Vrsta lokacije je obavezna."
                           Class="mb-3">
                    @foreach (var type in Lookups.LocationTypes)
                    {
                        <MudSelectItem T="int" Value="@type.Id">@type.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_model.ContactPerson"
                              Label="Kontakt osoba"
                              Counter="100"
                              MaxLength="100"
                              Immediate="true"
                              Class="mb-3" />
                <MudTextField @bind-Value="_model.ContactPhone"
                              Label="Telefon"
                              Counter="30"
                              MaxLength="30"
                              Immediate="true"
                              Class="mb-3" />
                <MudSwitch @bind-Value="_model.IsActive"
                           Label="Aktivna"
                           Color="Color.Primary" />
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="_busy || _loading"
                   OnClick="SubmitAsync">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Spremi
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int? LocationId { get; set; }

    private readonly LocationSaveDto _model = new();
    private MudForm? _form;
    private bool _valid;
    private bool _busy;
    private bool _loading;
    private bool _isEdit;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Lookups.EnsureLoadedAsync();

        if (LocationId is int id)
        {
            _isEdit = true;
            _loading = true;

            try
            {
                var detail = await Api.GetLocationAsync(id);
                MapFromDetail(detail);
            }
            catch (ApiClientException ex)
            {
                _error = ex.Message;
            }
            finally
            {
                _loading = false;
            }
        }
        else if (Lookups.LocationTypes.Count > 0)
        {
            _model.LocationTypeId = Lookups.LocationTypes[0].Id;
        }
    }

    private void MapFromDetail(LocationDetailDto detail)
    {
        _model.Code = detail.Code;
        _model.Name = detail.Name;
        _model.Address = detail.Address;
        _model.City = detail.City;
        _model.PostalCode = detail.PostalCode;
        _model.LocationTypeId = detail.LocationTypeId;
        _model.ContactPerson = detail.ContactPerson;
        _model.ContactPhone = detail.ContactPhone;
        _model.IsActive = detail.IsActive;
    }

    private async Task SubmitAsync()
    {
        if (_form is null || _loading)
            return;

        await _form.ValidateAsync();
        if (!_valid)
            return;

        _busy = true;
        _error = null;

        try
        {
            if (_isEdit && LocationId is int id)
                await Api.UpdateLocationAsync(id, _model);
            else
                await Api.CreateLocationAsync(_model);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiClientException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => MudDialog.Close(DialogResult.Cancel());
}
