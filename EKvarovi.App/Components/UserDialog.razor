@using EKvarovi.Shared.Dtos.Locations
@using EKvarovi.Shared.Dtos.Users
@inject ApiClient Api
@inject LookupCache Lookups

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEdit ? "Uredi korisnika" : "Novi korisnik")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-3" />
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">@_error</MudAlert>
        }

        @if (!_loading)
        {
            <MudForm @ref="_form" Model="_model" @bind-IsValid="_valid">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.FirstName"
                                      Label="Ime"
                                      Required="true"
                                      Counter="50"
                                      MaxLength="50"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.LastName"
                                      Label="Prezime"
                                      Required="true"
                                      Counter="50"
                                      MaxLength="50"
                                      Immediate="true" />
                    </MudItem>
                </MudGrid>
                <MudTextField @bind-Value="_model.Email"
                              Label="E-mail"
                              Required="true"
                              InputType="InputType.Email"
                              Counter="150"
                              MaxLength="150"
                              Immediate="true"
                              Class="mb-3 mt-3" />
                @if (!_isEdit)
                {
                    <MudTextField @bind-Value="_model.Password"
                                  Label="Lozinka"
                                  Required="true"
                                  InputType="InputType.Password"
                                  HelperText="Najmanje 8 znakova"
                                  Class="mb-3" />
                }
                <MudTextField @bind-Value="_model.Phone"
                              Label="Telefon"
                              Counter="30"
                              MaxLength="30"
                              Immediate="true"
                              Class="mb-3" />
                <MudTextField @bind-Value="_model.Specialization"
                              Label="Specijalizacija"
                              Counter="100"
                              MaxLength="100"
                              Immediate="true"
                              Class="mb-3" />
                <MudSelect T="int?"
                           @bind-Value="_model.HomeLocationId"
                           Label="Matična lokacija"
                           Clearable="true"
                           Class="mb-3">
                    @foreach (var location in _locations)
                    {
                        <MudSelectItem T="int?" Value="@location.Id">@location.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int"
                           SelectedValues="_selectedRoleIds"
                           SelectedValuesChanged="OnRolesChanged"
                           MultiSelection="true"
                           Label="Uloge"
                           Required="true"
                           RequiredError="Odaberite barem jednu ulogu."
                           Class="mb-3"
                           ToStringFunc="@(id => Lookups.Roles.FirstOrDefault(r => r.Id == id)?.Name ?? id.ToString())">
                    @foreach (var role in Lookups.Roles)
                    {
                        <MudSelectItem T="int" Value="@role.Id">@role.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Odustani</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="_busy || _loading"
                   OnClick="SubmitAsync">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Spremi
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int? UserId { get; set; }

    private readonly UserSaveDto _model = new();
    private readonly List<LocationListDto> _locations = [];
    private HashSet<int> _selectedRoleIds = [];
    private MudForm? _form;
    private bool _valid;
    private bool _busy;
    private bool _loading;
    private bool _isEdit;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Lookups.EnsureLoadedAsync();

        var locations = await Api.GetLocationsAsync(new LocationFilterDto
        {
            Page = 1,
            PageSize = 100,
            IsActive = true,
            SortBy = "name",
            SortDir = "asc"
        });
        _locations.AddRange(locations.Items);

        if (UserId is int id)
        {
            _isEdit = true;
            _loading = true;

            try
            {
                var detail = await Api.GetUserAsync(id);
                _model.FirstName = detail.FirstName;
                _model.LastName = detail.LastName;
                _model.Email = detail.Email;
                _model.Phone = detail.Phone;
                _model.Specialization = detail.Specialization;
                _model.HomeLocationId = detail.HomeLocationId;
                _selectedRoleIds = detail.RoleIds.ToHashSet();
                _model.RoleIds = detail.RoleIds.ToList();
            }
            catch (ApiClientException ex)
            {
                _error = ex.Message;
            }
            finally
            {
                _loading = false;
            }
        }
    }

    private void OnRolesChanged(IEnumerable<int> roleIds)
    {
        _selectedRoleIds = roleIds.ToHashSet();
        _model.RoleIds = _selectedRoleIds.ToList();
    }

    private async Task SubmitAsync()
    {
        if (_form is null || _loading)
            return;

        _model.RoleIds = _selectedRoleIds.ToList();

        await _form.ValidateAsync();
        if (!_valid || _model.RoleIds.Count == 0)
        {
            if (_model.RoleIds.Count == 0)
                _error = "Odaberite barem jednu ulogu.";
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            if (_isEdit && UserId is int id)
                await Api.UpdateUserAsync(id, _model);
            else
                await Api.CreateUserAsync(_model);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiClientException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => MudDialog.Close(DialogResult.Cancel());
}
