@page "/users"
@using System.Text.Json
@using EKvarovi.Shared.Common
@using EKvarovi.Shared.Dtos.Assignments
@using EKvarovi.Shared.Dtos.Locations
@using EKvarovi.Shared.Dtos.Users
@using EKvarovi.Shared.Enums
@inject ApiClient Api
@inject LookupCache Lookups
@inject JwtAuthStateProvider AuthState
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Korisnici</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4">Korisnici</MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="OpenCreateDialogAsync">
        Novi korisnik
    </MudButton>
</MudStack>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@_error</MudAlert>
}

<FilterBar OnReset="ResetFiltersAsync">
    <MudTextField @bind-Value="_filter.Search"
                  Label="Pretraga"
                  Placeholder="Ime, prezime, e-mail…"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true"
                  Style="min-width: 220px;" />
    <MudSelect T="int?" @bind-Value="_filter.RoleId" Label="Uloga" Clearable="true" Style="min-width: 180px;">
        @foreach (var role in Lookups.Roles)
        {
            <MudSelectItem T="int?" Value="@role.Id">@role.Name</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="int?" @bind-Value="_filter.LocationId" Label="Matična lokacija" Clearable="true" Style="min-width: 200px;">
        @foreach (var location in _locations)
        {
            <MudSelectItem T="int?" Value="@location.Id">@location.Name</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="string?" @bind-Value="_activeFilter" Label="Aktivnost" Clearable="true" Style="min-width: 160px;">
        <MudSelectItem T="string?" Value="@("true")">Aktivni</MudSelectItem>
        <MudSelectItem T="string?" Value="@("false")">Neaktivni</MudSelectItem>
    </MudSelect>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFiltersAsync">
        Primijeni
    </MudButton>
</FilterBar>

<MudTable T="UserListDto"
          @ref="_table"
          ServerData="LoadAsync"
          Hover="true"
          Dense="true"
          Loading="_loading">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="UserListDto" SortLabel="lastName">Prezime</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="UserListDto" SortLabel="firstName">Ime</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="UserListDto" SortLabel="email">E-mail</MudTableSortLabel></MudTh>
        <MudTh>Telefon</MudTh>
        <MudTh>Matična lokacija</MudTh>
        <MudTh>Uloge</MudTh>
        <MudTh><MudTableSortLabel T="UserListDto" SortLabel="isActive">Status</MudTableSortLabel></MudTh>
        <MudTh>Akcije</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Prezime">@context.LastName</MudTd>
        <MudTd DataLabel="Ime">@context.FirstName</MudTd>
        <MudTd DataLabel="E-mail">@context.Email</MudTd>
        <MudTd DataLabel="Telefon">@(context.Phone ?? "—")</MudTd>
        <MudTd DataLabel="Matična lokacija">@(context.HomeLocationName ?? "—")</MudTd>
        <MudTd DataLabel="Uloge">
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                @foreach (var role in context.Roles)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@role</MudChip>
                }
            </MudStack>
        </MudTd>
        <MudTd DataLabel="Status">
            @if (context.IsActive)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success">Aktivan</MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default">Neaktivan</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="Akcije">
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" aria-label="Akcije">
                <MudMenuItem OnClick="@(() => OpenEditDialogAsync(context.Id))">
                    Uredi
                </MudMenuItem>
                <MudMenuItem OnClick="@(() => OpenResetPasswordDialogAsync(context))">
                    Reset lozinke
                </MudMenuItem>
                @if (context.IsActive)
                {
                    <MudMenuItem OnClick="@(() => DeactivateAsync(context))">
                        Deaktiviraj
                    </MudMenuItem>
                }
                else
                {
                    <MudMenuItem OnClick="@(() => ActivateAsync(context))">
                        Aktiviraj
                    </MudMenuItem>
                }
            </MudMenu>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="pa-4 mud-text-secondary">Nema korisnika za odabrane filtere.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<UserListDto>? _table;
    private UserFilterDto _filter = new();
    private readonly List<LocationListDto> _locations = [];
    private string? _activeFilter;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!state.User.IsInRole(Roles.Admin))
        {
            _error = "Ova stranica je dostupna samo administratorima.";
            return;
        }

        await Lookups.EnsureLoadedAsync();

        try
        {
            var locations = await Api.GetLocationsAsync(new LocationFilterDto
            {
                Page = 1,
                PageSize = 100,
                IsActive = true,
                SortBy = "name",
                SortDir = "asc"
            });
            _locations.AddRange(locations.Items);
        }
        catch (ApiClientException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task<TableData<UserListDto>> LoadAsync(TableState state, CancellationToken ct)
    {
        if (!string.IsNullOrEmpty(_error) && _error.Contains("administratorima"))
            return new TableData<UserListDto> { Items = [], TotalItems = 0 };

        _loading = true;

        try
        {
            SyncActiveFilter();

            _filter.Page = state.Page + 1;
            _filter.PageSize = state.PageSize;
            _filter.SortBy = state.SortLabel;
            _filter.SortDir = state.SortDirection == SortDirection.Ascending ? "asc" : "desc";

            var result = await Api.GetUsersAsync(_filter, ct);
            return new TableData<UserListDto>
            {
                Items = result.Items,
                TotalItems = result.TotalCount
            };
        }
        catch (ApiClientException ex)
        {
            _error = ex.Message;
            return new TableData<UserListDto>
            {
                Items = [],
                TotalItems = 0
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private void SyncActiveFilter()
    {
        _filter.IsActive = _activeFilter switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };
    }

    private async Task ApplyFiltersAsync()
    {
        _filter.Page = 1;
        if (_table is not null)
            await _table.ReloadServerData();
    }

    private async Task ResetFiltersAsync()
    {
        _filter = new UserFilterDto();
        _activeFilter = null;

        if (_table is not null)
            await _table.ReloadServerData();
    }

    private async Task OpenCreateDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<UserDialog>(
            null,
            new DialogParameters<UserDialog>(),
            DialogOptions());

        if (await DialogSucceededAsync(dialog))
        {
            Snackbar.Add("Korisnik kreiran.", Severity.Success);
            await ReloadTableAsync();
        }
    }

    private async Task OpenEditDialogAsync(int userId)
    {
        var parameters = new DialogParameters<UserDialog>
        {
            { d => d.UserId, userId }
        };

        var dialog = await DialogService.ShowAsync<UserDialog>(null, parameters, DialogOptions());
        if (await DialogSucceededAsync(dialog))
        {
            Snackbar.Add("Korisnik ažuriran.", Severity.Success);
            await ReloadTableAsync();
        }
    }

    private async Task OpenResetPasswordDialogAsync(UserListDto user)
    {
        var parameters = new DialogParameters<ResetPasswordDialog>
        {
            { d => d.UserId, user.Id },
            { d => d.UserDisplayName, FormatUserName(user) }
        };

        var dialog = await DialogService.ShowAsync<ResetPasswordDialog>(null, parameters, DialogOptions());
        if (await DialogSucceededAsync(dialog))
            Snackbar.Add("Lozinka resetirana.", Severity.Success);
    }

    private async Task ActivateAsync(UserListDto user)
    {
        try
        {
            await Api.ActivateUserAsync(user.Id);
            Snackbar.Add("Korisnik aktiviran.", Severity.Success);
            await ReloadTableAsync();
        }
        catch (ApiClientException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeactivateAsync(UserListDto user)
    {
        try
        {
            await Api.DeactivateUserAsync(user.Id);
            Snackbar.Add("Korisnik deaktiviran.", Severity.Success);
            await ReloadTableAsync();
        }
        catch (ApiClientException ex) when (ex.StatusCode == 409)
        {
            var assignments = ParseActiveAssignments(ex.Error?.Payload);
            if (assignments.Count == 0)
            {
                Snackbar.Add(ex.Message, Severity.Error);
                return;
            }

            await OpenTransferDialogAsync(user, ex.Message, assignments);
        }
        catch (ApiClientException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenTransferDialogAsync(
        UserListDto user,
        string conflictMessage,
        IReadOnlyList<ActiveAssignmentInfoDto> assignments)
    {
        var parameters = new DialogParameters<DeactivateUserDialog>
        {
            { d => d.UserId, user.Id },
            { d => d.UserDisplayName, FormatUserName(user) },
            { d => d.ActiveAssignments, assignments },
            { d => d.ConflictMessage, conflictMessage }
        };

        var dialog = await DialogService.ShowAsync<DeactivateUserDialog>(
            null,
            parameters,
            new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Medium,
                FullWidth = true
            });

        if (await DialogSucceededAsync(dialog))
        {
            Snackbar.Add("Nalozi prebačeni i korisnik deaktiviran.", Severity.Success);
            await ReloadTableAsync();
        }
    }

    private async Task ReloadTableAsync()
    {
        if (_table is not null)
            await _table.ReloadServerData();
    }

    private static string FormatUserName(UserListDto user) =>
        $"{user.FirstName} {user.LastName}";

    private static List<ActiveAssignmentInfoDto> ParseActiveAssignments(object? payload)
    {
        if (payload is JsonElement element)
            return JsonSerializer.Deserialize<List<ActiveAssignmentInfoDto>>(element.GetRawText()) ?? [];

        return [];
    }

    private static DialogOptions DialogOptions() => new()
    {
        CloseButton = true,
        MaxWidth = MaxWidth.Medium,
        FullWidth = true
    };

    private static async Task<bool> DialogSucceededAsync(IDialogReference dialog)
    {
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }
}
